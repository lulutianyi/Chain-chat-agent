DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 百度智能云 OCR（资质自动核验，可选；留空时全部转人工核验）
BAIDU_API_KEY=
BAIDU_SECRET_KEY=
# 找回密码邮件（SMTP）。不配置时找回密码接口返回 503，登录不受影响。
# 587 端口通常用 STARTTLS；465 端口把 SMTP_SSL 设为 true、SMTP_STARTTLS 设为 false。
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# 发件人；留空时回退到 SMTP_USERNAME。
SMTP_FROM=
SMTP_STARTTLS=true
SMTP_SSL=false
# 验证码 / 重置令牌有效期（分钟）与单个验证码最大尝试次数。
PASSWORD_RESET_CODE_TTL_MINUTES=10
PASSWORD_RESET_TOKEN_TTL_MINUTES=10
PASSWORD_RESET_MAX_ATTEMPTS=5
# 本地默认 SQLite；公开部署请改成 Supabase/PostgreSQL，例如：
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/postgres
DATABASE_URL=sqlite:///./liantan.db
# 前端网址（CORS 白名单），公开部署改成 Vercel 给的域名
FRONTEND_ORIGIN=http://localhost:3000
# 采购方（商家）初始登录密码，公开部署务必改成强密码
MERCHANT_PASSWORD=链谈Agent123
# 采购方账号（账号+密码登录）与绑定手机号（验证码登录）
MERCHANT_ACCOUNT=admin
MERCHANT_PHONE=13800138000
# 运行环境：dev（默认）/ prod。设为 prod 时启动会强制自检，配置不安全会直接拒绝启动。
ENVIRONMENT=dev

# 演示模式：验证码不发送短信、直接回给前端。
# 打开等于「任何人可以对任意手机号拿到验证码并登录」，仅限本地/公开演示；
# ENVIRONMENT=prod 时必须设为 false 并接入真实短信服务。
DEMO_MODE=true

# 演示用管理员令牌：留空（默认）即禁用这条兜底鉴权。公开部署必须留空。
ADMIN_TOKEN=

# 日志格式：auto（prod 输出 JSON、dev 输出可读格式）/ json / text
LOG_FORMAT=auto
